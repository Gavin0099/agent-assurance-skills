{
  "hooks": {
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && [ -f \"$repo_root/.codex/hooks.json\" ] && if [ -x \"$repo_root/.venv/bin/python\" ]; then \"$repo_root/.venv/bin/python\" \"$repo_root/additional/ai-governance-framework/governance_tools/session_closeout_entry.py\" --format json --agent-id codex --trigger-mode native_hook --project-root \"$repo_root\"; else python3 \"$repo_root/additional/ai-governance-framework/governance_tools/session_closeout_entry.py\" --format json --agent-id codex --trigger-mode native_hook --project-root \"$repo_root\"; fi",
            "commandWindows": "powershell -NoProfile -EncodedCommand ",
            "timeout": 30,
            "statusMessage": "Running governance session closeout..."
          }
        ]
      }
    ],
    "SessionStart": [
      {
        "matcher": "^(startup|resume|clear|compact)$",
        "hooks": [
          {
            "type": "command",
            "command": "repo_root=\"$(git rev-parse --show-toplevel)\" && [ -f \"$repo_root/.codex/hooks.json\" ] && python3 \"$repo_root/additional/ai-governance-framework/runtime_hooks/adapters/codex/session_start.py\" --project-root \"$repo_root\"",
            "commandWindows": "powershell -NoProfile -EncodedCommand ",
            "timeout": 30,
            "statusMessage": "Establishing governance session identity..."
          }
        ]
      }
    ]
  }
}
